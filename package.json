{
  "name": "detector",
  "version": "0.0.1",
  "main": "webgl.js",
  "scripts": {
    "webgpu": "run-script-os",
    "webgl": "electron --enable-zero-copy --ignore-gpu-blocklist --zero-copy-video-capture --enable-gpu-rasterization webgl.js",
    "wasm": "electron --enable-zero-copy --ignore-gpu-blocklist --zero-copy-video-capture --enable-gpu-rasterization wasm.js",
    "js": "electron --enable-zero-copy --ignore-gpu-blocklist --zero-copy-video-capture --enable-gpu-rasterization jsonly.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "webgpu:win32:darwin": "electron --enable-unsafe-webgpu --enable-zero-copy --ignore-gpu-blocklist --zero-copy-video-capture --enable-gpu-rasterization webgpu.js",
    "webgpu:linux:": "electron --enable-features=Vulkan --enable-unsafe-webgpu --enable-zero-copy --ignore-gpu-blocklist --zero-copy-video-capture --enable-gpu-rasterization webgpu.js"
  },
  "author": "Geoffrey Stentiford",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tensorflow/tfjs-backend-wasm": "4.9.0",
    "@tensorflow/tfjs-backend-webgl": "4.9.0",
    "@tensorflow/tfjs-backend-webgpu": "4.9.0",
    "@tensorflow/tfjs-core": "4.9.0",
    "@tensorflow/tfjs-tflite": "^0.0.1-alpha.10",
    "electron": "^30.0.0",
    "run-script-os": "^1.1.6"
  }
}
